# PostgreSQL connection string. Any reachable Postgres works (local, Docker,
# or a free hosted instance like Neon/Supabase).
DATABASE_URL="postgresql://user:password@localhost:5432/civicpulse"

# Optional. Without this, the app automatically uses a deterministic local
# mock AI provider — full functionality, zero API calls.
GEMINI_API_KEY=

# Optional, reserved for a future Google Maps integration. The MVP dashboard
# always uses the built-in lightweight map — no external maps API required.
GOOGLE_MAPS_API_KEY=
